{
  "listen": "127.0.0.1:8787",
  "database": "data/router.db",
  "mode": "shadow",
  "high": {
    "base_url": "https://your-opus-provider.example",
    "model": "YOUR_OPUS_MODEL_ID",
    "api_key": "YOUR_OPUS_API_KEY",
    "auth": "api_key",
    "context_tokens": 200000,
    "cache": {
      "kind": "explicit",
      "ttl_seconds": 300
    },
    "prices": null
  },
  "low": {
    "base_url": "https://your-deepseek-provider.example/anthropic",
    "model": "deepseek-flash",
    "api_key": "YOUR_DEEPSEEK_API_KEY",
    "auth": "bearer",
    "context_tokens": 128000,
    "cache": {
      "kind": "automatic",
      "ttl_seconds": 300
    },
    "prices": null
  },
  "policy": {
    "version": "v1",
    "allow_text_switch": false,
    "min_switch_saving": 0.15,
    "estimated_output_tokens": 1024
  },
  "classifier": {
    "enabled": false,
    "timeout_ms": 2000,
    "max_chars": 6000
  }
}
